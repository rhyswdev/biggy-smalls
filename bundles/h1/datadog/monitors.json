    "id": 7391240,
    "name": "p90 latency high on payments-gw",
    "type": "query alert",
    "query": "max(last_5m):p90:trace.http.request.duration{service:checkout-api,peer.service:payments-gw,env:prod} > 6",
    "message": "{{#is_alert}}p90 latency from checkout-api to payments-gw is {{value}}s (threshold {{threshold}}s). Checkout payments are slow for customers.{{/is_alert}}\n{{#is_warning}}p90 latency to payments-gw is {{value}}s and rising.{{/is_warning}}\n{{#is_recovery}}p90 latency to payments-gw back under threshold.{{/is_recovery}}\nRunbook: https://confluence.larkspur.internal/display/SRE/CHECKOUT-LATENCY\n{{#is_alert}}@pagerduty-Payments-Prod{{/is_alert}} @slack-sre-oncall",
