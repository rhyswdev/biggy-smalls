# fetched by schemas/fetch.sh; only extracted subsets, the README, the script and the Statuspage sample are committed
schemas/*/openapi-*.yaml
schemas/*/*openapi*.json
schemas/*/*.py
schemas/*/*.java
schemas/*/*.c
schemas/kubernetes/swagger.json
.venv/
__pycache__/

# run records: the checkpoint databases and the runs index are rebuilt, never committed
checkpoints.sqlite*
eval/runs/index.sqlite*

# local secrets: never commit; copy .env.example to .env
.env
.env.*
!.env.example

# live run records of the eval loop: kept local; each has a committed row in eval/results/runs.jsonl
eval/loop-runs/
