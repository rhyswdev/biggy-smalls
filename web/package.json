{
  "name": "smalls-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --port ${SMALLS_WEB_PORT:-7317}",
    "build": "next build && node scripts/check-client-assets.mjs",
    "start": "next start --port ${SMALLS_WEB_PORT:-7317}",
    "lint": "node scripts/check-boundary.mjs && node scripts/check-types.mjs && node scripts/check-vocab.mjs && eslint . && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "types": "openapi-typescript lib/openapi.json -o lib/api-types.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
