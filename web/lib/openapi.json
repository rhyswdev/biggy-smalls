{
 "components": {
  "schemas": {
   "Answer": {
    "additionalProperties": false,
    "description": "One call's answer: approve (optionally with edited arguments), skip (defer) or reject with a reason.",
    "properties": {
     "approve": {
      "default": false,
      "title": "Approve",
      "type": "boolean"
     },
     "args": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Args"
     },
     "defer": {
      "default": false,
      "title": "Defer",
      "type": "boolean"
     },
     "reason": {
      "anyOf": [
       {
        "maxLength": 2000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Reason"
     }
    },
    "title": "Answer",
    "type": "object"
   },
   "GateAnswer": {
    "additionalProperties": false,
    "properties": {
     "answers": {
      "additionalProperties": {
       "$ref": "#/components/schemas/Answer"
      },
      "maxProperties": 50,
      "minProperties": 1,
      "title": "Answers",
      "type": "object"
     },
     "interrupt_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Interrupt Id",
      "type": "string"
     },
     "note": {
      "anyOf": [
       {
        "maxLength": 4000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     }
    },
    "required": [
     "interrupt_id",
     "answers"
    ],
    "title": "GateAnswer",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "MoreRun": {
    "additionalProperties": false,
    "properties": {
     "resume": {
      "default": false,
      "title": "Resume",
      "type": "boolean"
     }
    },
    "title": "MoreRun",
    "type": "object"
   },
   "NewChat": {
    "additionalProperties": false,
    "properties": {
     "auto_approve": {
      "default": false,
      "title": "Auto Approve",
      "type": "boolean"
     },
     "origin": {
      "enum": [
       "chat",
       "headless",
       "blank"
      ],
      "title": "Origin",
      "type": "string"
     },
     "title": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Title"
     },
     "trigger": {
      "anyOf": [
       {
        "maxLength": 8000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Trigger"
     }
    },
    "required": [
     "origin"
    ],
    "title": "NewChat",
    "type": "object"
   },
   "NoteIn": {
    "additionalProperties": false,
    "properties": {
     "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "title": "NoteIn",
    "type": "object"
   },
   "Switch": {
    "additionalProperties": false,
    "properties": {
     "on": {
      "title": "On",
      "type": "boolean"
     }
    },
    "required": [
     "on"
    ],
    "title": "Switch",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
