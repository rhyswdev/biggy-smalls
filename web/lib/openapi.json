     },
     "key": {
      "enum": [
       "exec",
       "support",
       "status",
       "eng"
      ],
      "title": "Key",
      "type": "string"
     },
     "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     }
    },
    "required": [
     "key",
     "name",
     "fallback"
    ],
    "title": "AudienceSpec",
    "type": "object"
   },
   "GateAnswer": {
    "additionalProperties": false,
