# Copy to .env (git-ignored) and fill in. Load with: uv run --env-file .env ...
# Needed for live runs: the second provider, which the default model set (sol) runs on
OPENAI_API_KEY=
# The first provider: the web app's stakeholder-message drafter, and live runs with SMALLS_SET=claude
ANTHROPIC_API_KEY=
# Optional: the classifier key, needed by `make tag` only; ingest, tests and the demo run without it
JEV_API_KEY=
